{
  "manifest_version": 3,
  "name": "GPT-Image2-Studio 商品图采集",
  "description": "按需采集 1688、Amazon、Temu、TikTok Shop、SHEIN 和大健云仓商品图，支持 Studio 导入、独立批量复制和下载。",
  "version": "1.1.29",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://detail.1688.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.de/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.it/*",
    "https://*.amazon.es/*",
    "https://*.amazon.co.jp/*",
    "https://*.amazon.com.au/*",
    "https://*.amazon.com.mx/*",
    "https://*.amazon.in/*",
    "https://*.temu.com/*",
    "https://www.tiktok.com/*",
    "https://shop.tiktok.com/*",
    "https://*.shein.com/*",
    "https://*.gigab2b.com/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://detail.1688.com/*",
        "https://*.amazon.com/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.de/*",
        "https://*.amazon.fr/*",
        "https://*.amazon.it/*",
        "https://*.amazon.es/*",
        "https://*.amazon.co.jp/*",
        "https://*.amazon.com.au/*",
        "https://*.amazon.com.mx/*",
        "https://*.amazon.in/*",
        "https://*.temu.com/*",
        "https://www.tiktok.com/*",
        "https://shop.tiktok.com/*",
        "https://*.shein.com/*",
        "https://*.gigab2b.com/*"
      ],
      "js": [
        "floating-launcher.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "商品图采集"
  }
}
