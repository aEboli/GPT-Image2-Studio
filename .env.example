OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
RESPONSES_MODEL=gpt-5.4-mini

# Direct-call mode keeps image generation and text/vision providers separate.
DIRECT_IMAGE_BASE_URL=https://api.openai.com/v1
DIRECT_IMAGE_API_KEY=
DIRECT_IMAGE_ENDPOINT_PATH=images/generations
DIRECT_IMAGE_MODEL=gpt-image-2
DIRECT_TEXT_BASE_URL=https://api.openai.com/v1
DIRECT_TEXT_API_KEY=
DIRECT_TEXT_ENDPOINT_PATH=responses
DIRECT_TEXT_MODEL=gpt-5.4-mini

# Legacy direct variables remain accepted as a migration fallback. Prefer the
# channel-specific DIRECT_IMAGE_* and DIRECT_TEXT_* variables above.
# DIRECT_BASE_URL=
# DIRECT_API_KEY=
# DIRECT_ENDPOINT_PATH=
# DIRECT_RESPONSES_MODEL=

# 默认留空，仅监听 127.0.0.1。需要局域网访问时再显式设置地址。
HOST=
# 可选。为所有非回环请求固定访问令牌；留空时启动时随机生成。
IMAGE_STUDIO_REQUEST_TOKEN=
# 仅兼容用途。设为 1 才允许非回环 HOST 直接使用未加密 HTTP；推荐保持关闭并使用 TLS 反向代理。
IMAGE_STUDIO_ALLOW_INSECURE_REMOTE_HTTP=0

# Local Node DNS fallback is enabled by default with 223.5.5.5 and 1.1.1.1.
# Set to 1 to keep Node's original DNS resolver list untouched.
IMAGE_STUDIO_DISABLE_DNS_FALLBACK=0
# Optional. Separate custom resolver IPs with commas, semicolons, or spaces.
IMAGE_STUDIO_DNS_FALLBACK_SERVERS=

# 套图单项上游请求的最长时间，默认 1200000（20 分钟）。
# 有效范围为 1000 到 3600000，超出会被收敛到边界。
IMAGE_STUDIO_CREATION_UPSTREAM_TIMEOUT_MS=1200000
# 仅测试用途。必须与 IMAGE_STUDIO_MOCK_IMAGE_GENERATION=1、IMAGE_STUDIO_OUTPUT_DIR
# 和 IMAGE_STUDIO_LOCAL_DATA_DIR 同时设置才会启用本地假图；缺一即忽略并打印告警。
# 正式运行请保持注释状态。
# IMAGE_STUDIO_ENABLE_TEST_MOCKS=0
